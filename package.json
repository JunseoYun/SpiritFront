{
  "name": "SpiritFront",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "android": "react-native run-android --mode=devDebug",
    "android-release": "react-native run-android --mode=release",
    "android-release-mac": "cd android && ./gradlew installProdRelease && cd .. && adb shell monkey -p com.spiritfront -c android.intent.category.LAUNCHER 1",
    "android-prod-debug-mac": "sh -c 'ENVFILE=.env.prod ./android/gradlew -p android installProdDebug && adb shell monkey -p com.spiritfront -c android.intent.category.LAUNCHER 1'",
    "android-dev-debug-mac": "sh -c 'ENVFILE=.env.dev ./android/gradlew -p android installProdDebug && adb shell monkey -p com.spiritfront -c android.intent.category.LAUNCHER 1'",
    "android-prod-debug": "set ENVFILE=.env.prod && cd android && gradlew.bat installProdDebug && cd .. && adb shell monkey -p com.spiritfront -c android.intent.category.LAUNCHER 1",
    "android-prod-release": "set ENVFILE=.env.prod && cd android && gradlew.bat installProdRelease && cd .. && adb shell monkey -p com.spiritfront -c android.intent.category.LAUNCHER 1",
    "build-android-prod-debug": "cd ./android && set ENVFILE=.env.prod && gradlew.bat assembleProdDebug && cd ../",
    "build-android-prod-release": "cd ./android && set ENVFILE=.env.prod && gradlew.bat assembleProdRelease && cd ../",
    "bundle-prod-release": "cd android && set ENVFILE=.env.prod && gradlew.bat bundleProdRelease && cd ../",
    "ios-dev": "ENVFILE=.env.dev npx react-native run-ios",
    "ios-prod": "ENVFILE=.env.prod npx react-native run-ios"
  },
  "dependencies": {
    "@actbase/react-daum-postcode": "^1.0.4",
    "@gorhom/bottom-sheet": "^4.6.4",
    "@invertase/react-native-apple-authentication": "^2.4.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/checkbox": "^0.5.17",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-native-picker/picker": "^2.10.2",
    "@react-native-seoul/kakao-login": "^5.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/material-top-tabs": "^7.1.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@react-navigation/stack": "^7.1.1",
    "axios": "^1.7.9",
    "firebase": "^11.3.0",
    "moment": "^2.30.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-config": "^1.5.5",
    "react-native-date-picker": "^5.0.8",
    "react-native-dotenv": "^3.4.11",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-fast-image": "^8.6.3",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.21.2",
    "react-native-image-crop-picker": "^0.41.6",
    "react-native-pager-view": "^6.6.1",
    "react-native-paper": "^5.13.1",
    "react-native-permissions": "^5.2.1",
    "react-native-reanimated": "^3.16.7",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "^4.4.0",
    "react-native-splash-screen": "^3.3.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "^13.12.5"
  },
  "reactNativePermissionsIOS": [
    "LocationAlways",
    "LocationWhenInUse"
  ],
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
